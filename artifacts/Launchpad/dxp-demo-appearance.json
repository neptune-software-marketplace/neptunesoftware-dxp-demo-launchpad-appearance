		{
			"title": "After Get Tiles",
			"name": "SuccessGetMenu",
			"description": "Triggers after GetTiles request and before tiles/tile groups is re-rendered if changes are detected in tiles/tile groups",
			"param": "",
			"sort": 40,
			"group": "Common",
			"content": [
				"==OBJECT STRING==",
				"if (AppCache.isMobile && !AppCache.enablePwa) {\r",
				"    setTimeout(() => {\r",
				"        sap.n.Shell.loadSidepanel(\"dxp_demo_appearance_help\", {\r",
				"            tabTitle: \"Help\"\r",
				"        });    \r",
				"    }, 1000);\r",
				"}"
			],
			"active": true,
			"disabled": false
		}
